AFKBOT_DB_URL=sqlite+aiosqlite:///./afkbot.db
AFKBOT_DB_POOL_SIZE=5
AFKBOT_DB_MAX_OVERFLOW=5
AFKBOT_DB_POOL_TIMEOUT_SEC=30
AFKBOT_DB_STATEMENT_TIMEOUT_MS=30000
AFKBOT_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
AFKBOT_DB_APPLICATION_NAME=afkbot
AFKBOT_DEPLOYMENT_MODE=self_hosted
AFKBOT_RUNTIME_PUBLIC_BIND_POLICY=local_only
AFKBOT_PLUGIN_API_AUTH_REQUIRED=1
AFKBOT_PARTYFLOW_WEBHOOK_SIGNING_REQUIRED=0
AFKBOT_MANAGED_DATABASE_ISOLATION_MODE=database_per_bot
AFKBOT_LLM_PROVIDER=openrouter
AFKBOT_LLM_MODEL=minimax/minimax-m2.5
AFKBOT_LLM_API_KEY=
AFKBOT_LLM_BASE_URL=
AFKBOT_OPENROUTER_API_KEY=
AFKBOT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AFKBOT_OPENAI_API_KEY=
AFKBOT_OPENAI_BASE_URL=https://api.openai.com/v1
AFKBOT_DEEPSEEK_API_KEY=
AFKBOT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AFKBOT_XAI_API_KEY=
AFKBOT_XAI_BASE_URL=https://api.x.ai/v1
AFKBOT_QWEN_API_KEY=
AFKBOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AFKBOT_CUSTOM_API_KEY=
AFKBOT_CUSTOM_BASE_URL=
AFKBOT_CUSTOM_INTERFACE=openai
AFKBOT_BRAVE_API_KEY=
AFKBOT_LLM_PROXY_TYPE=none
AFKBOT_LLM_PROXY_URL=
AFKBOT_LLM_REQUEST_TIMEOUT_SEC=30
AFKBOT_LLM_MAX_ITERATIONS=50
AFKBOT_CREDENTIALS_MASTER_KEYS=
AFKBOT_MEMORY_RETENTION_DAYS=180
AFKBOT_MEMORY_MAX_ITEMS_PER_PROFILE=5000
AFKBOT_ENABLE_PROFILE_APP_MODULES=0
AFKBOT_RUNTIME_HOST=127.0.0.1
AFKBOT_RUNTIME_PORT=46339
AFKBOT_RUNTIME_QUEUE_MAX_SIZE=100
AFKBOT_RUNTIME_WORKER_COUNT=4
AFKBOT_RUNTIME_CRON_INTERVAL_SEC=60
AFKBOT_RUNTIME_SHUTDOWN_TIMEOUT_SEC=10
AFKBOT_RUNTIME_READ_TIMEOUT_SEC=5
AFKBOT_RUNTIME_MAX_HEADER_BYTES=16384
AFKBOT_RUNTIME_MAX_BODY_BYTES=262144
# Cloud-hosted containers only. Production uses AFKBOT_DEPLOYMENT_MODE=managed and wss://.
# AFKBOT_MANAGED_MODE is a legacy compatibility flag; leave it disabled locally.
AFKBOT_MANAGED_MODE=0
AFKBOT_CONTROL_WS_URL=
AFKBOT_RUNTIME_WS_TOKEN=
AFKBOT_CLOUD_GATEWAY_ALLOW_INSECURE_WS=0
AFKBOT_CLOUD_GATEWAY_HEARTBEAT_INTERVAL_SEC=20
AFKBOT_CLOUD_GATEWAY_RECONNECT_INITIAL_SEC=1
AFKBOT_CLOUD_GATEWAY_RECONNECT_MAX_SEC=30
AFKBOT_CLOUD_GATEWAY_MESSAGE_MAX_BYTES=262144
# Optional detached runtime worker filter by ai_profile owner_ref.
# Empty/unset means runtime can claim tasks for all ai_profile owners.
AFKBOT_TASKFLOW_RUNTIME_OWNER_REF=
AFKBOT_TASKFLOW_PUBLIC_PRINCIPAL_REQUIRED=0
AFKBOT_TASKFLOW_STRICT_TEAM_PROFILE_IDS=0
AFKBOT_NGINX_ENABLED=0
AFKBOT_NGINX_PORT=18080
